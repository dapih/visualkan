{
  "name": "visualkan",
  "version": "0.5.0",
  "description": "Generate visual explanations (whiteboard, infographic, presentation, diagram, mindmap, mockup) from any content using native subscription capabilities (Antigravity/Codex) or image generation APIs (OpenAI, Gemini, OpenRouter)",
  "author": {
    "name": "Davi Muammar",
    "url": "https://github.com/dapih"
  },
  "license": "MIT",
  "created": "2026-08-13",
  "updated": "2026-08-15",
  "keywords": [
    "visualkan",
    "whiteboard",
    "infographic",
    "mindmap",
    "mockup",
    "wireframe",
    "diagram",
    "image-generation",
    "gpt-image",
    "nano-banana",
    "flux",
    "krea",
    "seedream"
  ],
  "dependencies": {
    "runtime": [
      "node>=24",
      "visualkan"
    ],
    "env": [
      "OPENAI_API_KEY",
      "GEMINI_API_KEY",
      "OPENROUTER_API_KEY"
    ]
  },
  "styles": [
    "whiteboard",
    "infographic",
    "presentation",
    "diagram",
    "mindmap",
    "mindmap-structured",
    "mockup"
  ],
  "entry": "visualkan.md"
}
